{
  "name": "whatsapp-campaign-manager",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Production-grade WhatsApp Bulk Campaign Manager",
  "main": "server.ts",
  "scripts": {
    "dev": "node --env-file=.env --loader ts-node/esm server.ts",
    "start": "node --env-file=.env --loader ts-node/esm server.ts",
    "build": "tsc --outDir dist",
    "serve": "node dist/server.js",
    "db:init": "node --env-file=.env scripts/init-db.js",
    "db:seed": "node --env-file=.env scripts/seed-db.js",
    "test": "node --env-file=.env --test tests/validation.test.js tests/campaigns.test.js tests/crypto.test.js tests/excel.test.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/mongodb": "^4.0.6",
    "@types/multer": "^1.4.11",
    "bcryptjs": "^3.0.3",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "twilio": "^5.3.0",
    "typescript": "^5.5.4",
    "xlsx": "^0.18.5",
    "ejs": "^3.1.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.5.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
