<% layout('layout') %>

<div class="page-header">
  <h1>Settings</h1>
  <p class="text-muted">Configure your WhatsApp and Twilio settings</p>
</div>

<div style="display:grid;grid-template-columns:1fr;gap:20px;max-width:600px;">
  <div class="card">
    <div class="card-header">
      <h2>Twilio Configuration</h2>
    </div>
    <div style="padding:16px;display:flex;flex-direction:column;gap:16px;">
      <div>
        <label>Twilio Account SID</label>
        <input type="text" value="<%= settings.accountSid || '' %>" disabled style="background:var(--bg-secondary);" />
      </div>
      <div>
        <label>Twilio Auth Token</label>
        <input type="password" value="<%= settings.authToken || '' %>" disabled style="background:var(--bg-secondary);" />
      </div>
      <div>
        <label>WhatsApp Business Phone</label>
        <input type="text" value="<%= settings.whatsappNumber || '' %>" disabled style="background:var(--bg-secondary);" />
      </div>
      <div>
        <label>Default Template SID</label>
        <input type="text" value="<%= settings.defaultTemplateSid || '' %>" disabled style="background:var(--bg-secondary);" />
      </div>
      <p style="font-size:12px;color:var(--text-muted);margin:0;">
        Configure these settings in your environment variables.
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Send Settings</h2>
    </div>
    <form id="settingsForm">
      <div class="form-group">
        <label for="delayMin">Delay Between Messages (min, seconds)</label>
        <input type="number" id="delayMin" name="delayMin" value="1" />
      </div>
      <div class="form-group">
        <label for="delayMax">Delay Between Messages (max, seconds)</label>
        <input type="number" id="delayMax" name="delayMax" value="5" />
      </div>
      <div class="form-group">
        <label for="maxRetries">Max Retries</label>
        <input type="number" id="maxRetries" name="maxRetries" value="3" />
      </div>
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Test Message</h2>
    </div>
    <form id="testForm">
      <div class="form-group">
        <label for="testPhone">Phone Number</label>
        <input type="tel" id="testPhone" name="phone" required placeholder="+1234567890" />
      </div>
      <button type="submit" class="btn btn-primary">Send Test Message</button>
    </form>
  </div>
</div>

<script>
  document.getElementById('testForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const phone = document.getElementById('testPhone').value;
    try {
      const res = await fetch('/api/test-message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, templateSid: '<%= settings.defaultTemplateSid %>' })
      });
      if (!res.ok) throw new Error('Failed to send');
      alert('Test message sent!');
    } catch (err) {
      alert(err.message);
    }
  });

  setupThemeToggle();
  setupSidebarToggle();
</script>
