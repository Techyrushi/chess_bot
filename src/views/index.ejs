<% layout('layout') %>

<div class="page-header">
  <div>
    <h1>Dashboard</h1>
    <p class="text-muted">Overview of your WhatsApp campaigns</p>
  </div>
</div>

<div class="stat-grid" style="margin-bottom:28px;">
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">📊</div>
    <div class="stat-label">Total Campaigns</div>
    <div class="stat-value"><%= stats.totalCampaigns %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--success-light);color:var(--success);">👥</div>
    <div class="stat-label">Active Contacts</div>
    <div class="stat-value"><%= stats.totalContacts %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--info-light);color:var(--info);">📤</div>
    <div class="stat-label">Active Campaigns</div>
    <div class="stat-value"><%= stats.activeCampaigns %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--warning-light);color:var(--warning);">📨</div>
    <div class="stat-label">Messages Sent</div>
    <div class="stat-value"><%= stats.totalSent %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--success-light);color:var(--success);">✓</div>
    <div class="stat-label">Delivered</div>
    <div class="stat-value"><%= stats.totalDelivered %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--info-light);color:var(--info);">👁</div>
    <div class="stat-label">Read</div>
    <div class="stat-value"><%= stats.totalRead %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">✕</div>
    <div class="stat-label">Failed</div>
    <div class="stat-value"><%= stats.totalFailed %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">🚫</div>
    <div class="stat-label">Opt-outs</div>
    <div class="stat-value"><%= stats.optOuts %></div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:20px;">
  <div class="card">
    <div class="card-header">
      <h2>Recent Campaigns</h2>
      <a href="/campaigns" class="link-small">View all →</a>
    </div>
    <div class="card-body">
      <% if (stats.campaigns && stats.campaigns.length > 0) { %>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <% stats.campaigns.forEach(campaign => { %>
            <div style="padding:12px;border-radius:8px;background:var(--bg-secondary);display:flex;justify-content:space-between;align-items:center;">
              <div>
                <div style="font-weight:500;"><%= campaign.name %></div>
                <div style="font-size:12px;color:var(--text-muted);"><%= campaign.list_name || 'No list' %></div>
              </div>
              <span class="badge" style="background:var(--<%= campaign.status === 'sending' ? 'info' : campaign.status === 'completed' ? 'success' : campaign.status === 'failed' ? 'danger' : 'secondary' %>-light);"><%= campaign.status %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="text-align:center;color:var(--text-muted);">No campaigns yet</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Recent Messages</h2>
      <a href="/inbox" class="link-small">View all →</a>
    </div>
    <div class="card-body">
      <% if (stats.recentIncoming && stats.recentIncoming.length > 0) { %>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <% stats.recentIncoming.slice(0, 5).forEach(msg => { %>
            <div style="padding:12px;border-radius:8px;background:var(--bg-secondary);border-left:3px solid var(--info);">
              <div style="font-weight:500;"><%= msg.contact_name || msg.from || 'Unknown' %></div>
              <div style="font-size:12px;color:var(--text-muted);margin-top:4px;"><%= msg.body || '' %></div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="text-align:center;color:var(--text-muted);">No messages yet</p>
      <% } %>
    </div>
  </div>
</div>

<script>
  setupThemeToggle();
  setupSidebarToggle();
</script>
