<% layout('layout') %>

<div class="page-header">
  <h1>Audit Logs</h1>
  <p class="text-muted">Activity history and system events</p>
</div>

<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>Admin</th>
        <th>Action</th>
        <th>Description</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% if (logs && logs.length > 0) { %>
        <% logs.forEach(log => { %>
          <tr>
            <td><small><%= log.admin_id %></small></td>
            <td><small><%= log.action %></small></td>
            <td><small><%= log.description %></small></td>
            <td><small><%= new Date(log.created_at).toLocaleString() %></small></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="4" style="text-align:center;padding:30px;color:var(--text-muted);">
            No audit logs
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <% if (pagination && pagination.pages > 1) { %>
    <div class="pagination">
      <% if (pagination.hasPrev) { %>
        <a href="?page=<%= pagination.page - 1 %>" class="btn btn-sm">← Previous</a>
      <% } %>
      <span style="margin:0 12px;">Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if (pagination.hasNext) { %>
        <a href="?page=<%= pagination.page + 1 %>" class="btn btn-sm">Next →</a>
      <% } %>
    </div>
  <% } %>
</div>

<script>
  setupThemeToggle();
  setupSidebarToggle();
</script>
