<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="WhatsApp Bulk Campaign Manager">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>">
  <title><%= title ? title + ' — ' : '' %>WhatsApp Campaign Manager</title>
  <link rel="stylesheet" href="/css/global.css">
  <script>
    (function() {
      try {
        const t = localStorage.getItem('theme');
        const m = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (t === 'dark' || (!t && m)) document.documentElement.classList.add('dark');
      } catch(_) {}
    })();
  </script>
</head>
<body>
  <% if (typeof admin !== 'undefined' && admin) { %>
    <div class="app-layout">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <div class="sidebar-logo">W</div>
          <div class="sidebar-brand">WhatsApp<br />Campaigns</div>
        </div>
        <nav class="sidebar-nav">
          <div class="sidebar-section">
            <div class="sidebar-section-label">Main</div>
            <a href="/" class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>">
              <span class="nav-link-icon">📊</span> Dashboard
            </a>
            <a href="/campaigns/new" class="nav-link <%= title === 'Compose Campaign' ? 'active' : '' %>">
              <span class="nav-link-icon">✉️</span> Compose Message
            </a>
            <a href="/campaigns" class="nav-link <%= title === 'Campaigns' ? 'active' : '' %>">
              <span class="nav-link-icon">📤</span> Campaigns
            </a>
            <a href="/import" class="nav-link <%= title === 'Import Contacts' ? 'active' : '' %>">
              <span class="nav-link-icon">📥</span> Import Contacts
            </a>
            <a href="/templates" class="nav-link <%= title === 'Templates' ? 'active' : '' %>">
              <span class="nav-link-icon">📝</span> Templates
            </a>
            <a href="/settings" class="nav-link <%= title === 'Settings' ? 'active' : '' %>">
              <span class="nav-link-icon">⚙️</span> Settings
            </a>
            <a href="/inbox" class="nav-link <%= title === 'Inbox' ? 'active' : '' %>">
              <span class="nav-link-icon">📬</span> Inbox
            </a>
            <a href="/audit-logs" class="nav-link <%= title === 'Audit Logs' ? 'active' : '' %>">
              <span class="nav-link-icon">📋</span> Audit Logs
            </a>
          </div>
        </nav>
        <div class="sidebar-footer">
          <div class="user-section">
            <div class="user-avatar"><%= admin.email.charAt(0).toUpperCase() %></div>
            <div class="user-info">
              <div class="user-name"><%= admin.email %></div>
              <div class="user-status">Admin</div>
            </div>
            <button class="btn-logout" onclick="logout()">🚪</button>
          </div>
        </div>
      </aside>

      <main class="app-content">
        <header class="app-header">
          <button class="btn-toggle-sidebar" data-sidebar-toggle>☰</button>
          <div class="header-spacer"></div>
          <button class="btn-theme-toggle" data-theme-toggle>🌙</button>
        </header>
        
        <div class="app-body">
          <%- body %>
        </div>
      </main>
    </div>
  <% } else { %>
    <%- body %>
  <% } %>

  <div class="toast-container"></div>
  <script src="/js/app.js"></script>
  <script>
    function logout() {
      if (confirm('Are you sure you want to logout?')) {
        fetch('/api/auth/logout', { method: 'POST' })
          .then(() => location.href = '/login')
          .catch(err => alert('Logout failed'));
      }
    }
  </script>
</body>
</html>
