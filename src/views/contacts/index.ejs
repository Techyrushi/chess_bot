<% layout('layout') %>

<div class="page-header">
  <div>
    <h1>Contacts</h1>
    <p class="text-muted">Manage your contact list</p>
  </div>
</div>

<div class="card">
  <div style="padding:16px;border-bottom:1px solid var(--border-color);display:flex;gap:12px;">
    <input type="text" id="searchInput" placeholder="Search by phone, name, email..." style="flex:1;" />
    <button onclick="search()" class="btn btn-primary">Search</button>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Phone</th>
        <th>Name</th>
        <th>Company</th>
        <th>City</th>
        <th>Lists</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% if (contacts && contacts.length > 0) { %>
        <% contacts.forEach(contact => { %>
          <tr>
            <td><strong><%= contact.phone %></strong></td>
            <td><%= contact.name || '-' %></td>
            <td><%= contact.company || '-' %></td>
            <td><%= contact.city || '-' %></td>
            <td><small><%= contact.lists || '-' %></small></td>
            <td><%= new Date(contact.created_at).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align:center;padding:30px;color:var(--text-muted);">
            No contacts found
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <% if (pagination && pagination.pages > 1) { %>
    <div class="pagination">
      <% if (pagination.hasPrev) { %>
        <a href="?page=<%= pagination.page - 1 %>" class="btn btn-sm">← Previous</a>
      <% } %>
      <span style="margin:0 12px;">Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if (pagination.hasNext) { %>
        <a href="?page=<%= pagination.page + 1 %>" class="btn btn-sm">Next →</a>
      <% } %>
    </div>
  <% } %>
</div>

<script>
  function search() {
    const query = document.getElementById('searchInput').value;
    location.href = `/contacts?search=${encodeURIComponent(query)}`;
  }

  setupThemeToggle();
  setupSidebarToggle();
</script>
