---
import '../styles/global.css';
import { getAdminById } from '../lib/auth';
import { getDashboardStats } from '../services/campaigns';
import { cleanupExpiredSessions, parseSessionFromCookies, getSession } from '../lib/sessions';

const { title } = Astro.props as { title?: string };

const cookieHeader = Astro.request.headers.get('cookie');
const sessionId = parseSessionFromCookies(cookieHeader);
const session = sessionId ? await getSession(sessionId) : null;
const pathname = Astro.url.pathname;
const isLoginPage = pathname === '/login';

let redirectUrl: string | null = null;
if (!session && !isLoginPage) {
  redirectUrl = '/login';
} else if (session && isLoginPage) {
  redirectUrl = '/';
}

try { await cleanupExpiredSessions(); } catch (_) {}

const admin = session?.adminId ? await getAdminById(session.adminId) : null;
const stats = admin ? await getDashboardStats() : null;
const unread = stats?.unreadMessages || 0;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💬</text></svg>" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="WhatsApp Bulk Campaign Manager" />
  {redirectUrl && (
    <>
      <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
      <script is:inline define:vars={{redirectUrl}}>location.replace(redirectUrl);</script>
    </>
  )}
  <title>{title ? title + ' — ' : ''}WhatsApp Campaign Manager</title>
  <script is:inline define:vars={{unread}}>
    (function() {
      try {
        const t = localStorage.getItem('theme');
        const m = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (t === 'dark' || (!t && m)) document.documentElement.classList.add('dark');
      } catch(_) {}
    })();
  </script>
</head>
<body>
  {!isLoginPage && admin && (
    <div class="app-layout">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <div class="sidebar-logo">W</div>
          <div class="sidebar-brand">WhatsApp<br />Campaigns</div>
        </div>
        <nav class="sidebar-nav">
          <div class="sidebar-section">
            <div class="sidebar-section-label">Main</div>
            <a href="/" class="nav-link {pathname === '/' ? 'active' : ''}">
              <span class="nav-link-icon">📊</span> Dashboard
            </a>
            <a href="/campaigns/new" class="nav-link {pathname === '/campaigns/new' ? 'active' : ''}">
              <span class="nav-link-icon">✉️</span> Compose Message
            </a>
            <a href="/campaigns" class="nav-link {pathname === '/campaigns' || (pathname.startsWith('/campaign') && pathname !== '/campaigns/new') ? 'active' : ''}">
              <span class="nav-link-icon">📤</span> Campaigns
            </a>
            <a href="/import" class="nav-link {pathname.startsWith('/import') || pathname.startsWith('/contact') ? 'active' : ''}">
              <span class="nav-link-icon">📥</span> Import Contacts
            </a>
            <a href="/templates" class="nav-link {pathname === '/templates' ? 'active' : ''}">
              <span class="nav-link-icon">📝</span> Templates
            </a>
            <a href="/settings" class="nav-link {pathname.startsWith('/setting') ? 'active' : ''}">
              <span class="nav-link-icon">⚙️</span> Settings
            </a>
          </div>
        </nav>
        <div class="sidebar-footer">
          <div class="admin-mini">
            <div class="admin-avatar">{(admin.name || admin.email || 'A').charAt(0).toUpperCase()}</div>
            <div class="admin-info">
              <div class="admin-name">{admin.name || 'Admin'}</div>
              <div class="admin-email">{admin.email}</div>
            </div>
          </div>
        </div>
      </aside>

      <div class="main-content">
        <header class="topbar">
          <div class="topbar-left" style="display:flex;align-items:center">
            <button class="mobile-menu-toggle" data-sidebar-toggle aria-label="Menu">☰</button>
            <h1><slot name="title" /></h1>
          </div>
          <div class="topbar-right">
            <button class="theme-toggle" data-theme-toggle title="Toggle theme" aria-label="Toggle theme">🌗</button>
            <a href="/settings" class="btn btn-ghost btn-sm" title="Settings">⚙️</a>
            <button class="btn btn-ghost btn-sm" id="logoutBtn" title="Logout">🚪 Logout</button>
          </div>
        </header>

        <main class="page-content">
          <slot />
        </main>
      </div>
    </div>
  )}

  {isLoginPage && <slot />}

  <script>
    import { setupThemeToggle, setupSidebarToggle, api, toast } from '../scripts/app.js';
    setupThemeToggle();
    setupSidebarToggle();

    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          await api('/api/auth/logout', { method: 'POST' });
          toast('Logged out', 'success');
          setTimeout(() => { location.href = '/login'; }, 400);
        } catch (_) {}
      });
    }
  </script>
</body>
</html>
