---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Fragment slot="title">Page Not Found</Fragment>
  <div style="text-align:center;padding:80px 20px;">
    <div style="font-size:96px;margin-bottom:16px;opacity:0.4;">404</div>
    <h1 style="font-size:28px;font-weight:700;margin-bottom:8px;">Page Not Found</h1>
    <p style="color:var(--text-muted);margin-bottom:24px;">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="btn btn-primary">← Back to Dashboard</a>
  </div>
</Layout>
