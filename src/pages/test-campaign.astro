---
import Layout from '../layouts/Layout.astro';
import { listCampaigns } from '../services/campaigns';

const campaigns = await listCampaigns({ page: 1, perPage: 100 });
---

<Layout>
  <Fragment slot="title">Campaign Test</Fragment>

  <div class="breadcrumbs"><a href="/">Dashboard</a> / <span>Test Campaign</span></div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Campaign Diagnostics & Test</div>
    </div>

    <div style="padding: 20px;">
      <div style="margin-bottom: 20px;">
        <label style="display: block; margin-bottom: 8px; font-weight: 500;">Select Campaign:</label>
        <select id="campaignSelect" style="width: 100%; max-width: 400px; padding: 8px; border: 1px solid var(--border); border-radius: var(--radius);">
          <option value="">-- Choose a campaign --</option>
          {campaigns.campaigns?.map((c: any) => (
            <option value={c.id}>{c.name} ({c.status})</option>
          ))}
        </select>
      </div>

      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <button id="testBtn" class="btn btn-primary" disabled>Test Campaign</button>
        <button id="clearBtn" class="btn btn-secondary">Clear Results</button>
      </div>

      <div id="results" style="display: none; background: var(--bg-tertiary); padding: 20px; border-radius: var(--radius); font-family: monospace; font-size: 12px; max-height: 600px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;"></div>
    </div>
  </div>

  <script>
    import { api, toast } from '../scripts/app.js';

    const campaignSelect = document.getElementById('campaignSelect') as HTMLSelectElement;
    const testBtn = document.getElementById('testBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
    const results = document.getElementById('results') as HTMLDivElement;

    campaignSelect.addEventListener('change', () => {
      testBtn.disabled = !campaignSelect.value;
    });

    testBtn.addEventListener('click', async () => {
      const campaignId = campaignSelect.value;
      if (!campaignId) return;

      testBtn.disabled = true;
      results.textContent = 'Testing...';
      results.style.display = 'block';

      try {
        const response = await api('/api/debug/campaign-test', {
          method: 'POST',
          body: { campaignId }
        });

        results.textContent = JSON.stringify(response, null, 2);
        toast('Test complete - check results below', 'success');
      } catch (err: any) {
        results.textContent = `Error: ${err.message}\n\n${err.stack || ''}`;
        toast('Test failed - check results', 'error');
      } finally {
        testBtn.disabled = false;
      }
    });

    clearBtn.addEventListener('click', () => {
      results.textContent = '';
      results.style.display = 'none';
    });
  </script>

  <style>
    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
</Layout>
