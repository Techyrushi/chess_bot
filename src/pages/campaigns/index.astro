---
import Layout from '../../layouts/Layout.astro';
import { listCampaigns } from '../../services/campaigns';
import { statusMeta, formatNumber, formatDate } from '../../scripts/app.js';

const initialData = await listCampaigns({ page: 1, perPage: 20 });
const initialCampaigns = initialData.campaigns || [];
---

<Layout>
  <Fragment slot="title">Campaigns</Fragment>

  <div class="breadcrumbs"><a href="/">Dashboard</a> / <span>Campaigns</span></div>

  <div class="card" style="margin-bottom:20px;">
    <div class="card-header">
      <div class="card-title">All Campaigns</div>
      <a href="/campaigns/new" class="btn btn-primary btn-sm">+ New Campaign</a>
    </div>

    <div class="filters-row">
      <div style="flex:1;min-width:240px;">
        <div class="search-input"><input type="search" id="searchInput" placeholder="Search campaigns..." /></div>
      </div>
      <select id="statusFilter" style="max-width:200px;">
        <option value="">All statuses</option>
        <option value="draft">Draft</option>
        <option value="queued">Queued</option>
        <option value="sending">Sending</option>
        <option value="paused">Paused</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
        <option value="failed">Failed</option>
      </select>
    </div>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Name</th><th>List</th><th>Status</th>
            <th>Progress</th>
            <th>Total</th><th>Sent</th><th>Delivered</th><th>Read</th><th>Failed</th>
            <th>Created</th><th>Actions</th>
          </tr>
        </thead>
        <tbody id="tbody">
          {initialCampaigns.length === 0 ? (
            <tr>
              <td colspan="11" style="text-align:center;padding:60px;">
                <div class="empty-state">
                  <div class="empty-state-icon">📤</div>
                  <div class="empty-state-title">No campaigns</div>
                  <div class="empty-state-subtitle">Create your first WhatsApp campaign to get started</div>
                  <a href="/campaigns/new" class="btn btn-primary">+ Create Campaign</a>
                </div>
              </td>
            </tr>
          ) : (
            initialCampaigns.map(c => {
              const meta = statusMeta(c.status);
              const total = c.total_contacts || 1;
              const sent = c.sent_count + c.delivered_count + c.read_count + c.failed_count + c.undelivered_count;
              const pct = Math.min(100, Math.round(sent / total * 100));
              return (
                <tr>
                  <td><a href={`/campaigns/${c.id}`} style="font-weight:600">{c.name}</a></td>
                  <td>{c.list_name || <span style="color:var(--text-muted);">-</span>}</td>
                  <td><span class={`badge ${meta.cls}`}>{meta.label}</span></td>
                  <td style="min-width:180px;">
                    <div style="display:flex;align-items:center;gap:8px;">
                      <div class="progress" style="flex:1;"><div class="progress-bar" style={`width:${pct}%`}></div></div>
                      <span style="font-size:12px;color:var(--text-muted);white-space:nowrap;">{pct}%</span>
                    </div>
                  </td>
                  <td>{formatNumber(c.total_contacts)}</td>
                  <td>{formatNumber(c.sent_count)}</td>
                  <td><span style="color:var(--success);font-weight:500;">{formatNumber(c.delivered_count)}</span></td>
                  <td><span style="color:var(--info);font-weight:500;">{formatNumber(c.read_count)}</span></td>
                  <td><span style="color:var(--danger);font-weight:500;">{formatNumber(c.failed_count + c.undelivered_count)}</span></td>
                  <td>{formatDate(c.created_at)}</td>
                  <td>
                    <div class="row-actions" style="display:flex;gap:6px;">
                      <a class="btn btn-sm btn-secondary" href={`/campaigns/${c.id}`}>View</a>
                      {c.status !== 'sending' && <button class="btn btn-sm btn-danger btn-delete-campaign" data-id={c.id}>🗑</button>}
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
    <div class="pagination" id="pagination"></div>
  </div>

  <script>
    import { api, formatDate, statusMeta, escapeHtml, formatNumber, paginateUi, toast } from '../../scripts/app.js';
    const tbody = document.getElementById('tbody')!;
    const pagination = document.getElementById('pagination')!;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;
    let page = 1; const perPage = 20;
    let all: any[] = [];

    async function loadCampaigns() {
      try {
        const data = await api(`/api/campaigns?page=${page}&perPage=${perPage}${statusFilter.value ? `&status=${statusFilter.value}` : ''}`);
        all = data.campaigns;
        const q = searchInput.value.trim().toLowerCase();
        const filtered = q ? all.filter(c => c.name.toLowerCase().includes(q) || (c.list_name || '').toLowerCase().includes(q)) : all;
        if (!filtered.length) {
          tbody.innerHTML = `<tr><td colspan="11" style="text-align:center;padding:60px;"><div class="empty-state"><div class="empty-state-icon">📤</div><div class="empty-state-title">No campaigns</div><div class="empty-state-subtitle">Create your first WhatsApp campaign to get started</div><a href="/campaigns/new" class="btn btn-primary">+ Create Campaign</a></div></td></tr>`;
        } else {
          tbody.innerHTML = filtered.map(c => {
            const meta = statusMeta(c.status);
            const total = c.total_contacts || 1;
            const sent = c.sent_count + c.delivered_count + c.read_count + c.failed_count + c.undelivered_count;
            const pct = Math.min(100, Math.round(sent / total * 100));
            return `<tr>
              <td><a href="/campaigns/${c.id}" style="font-weight:600">${escapeHtml(c.name)}</a></td>
              <td>${c.list_name ? escapeHtml(c.list_name) : '<span style="color:var(--text-muted);">-</span>'}</td>
              <td><span class="badge ${meta.cls}">${meta.label}</span></td>
              <td style="min-width:180px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <div class="progress" style="flex:1;"><div class="progress-bar" style="width:${pct}%"></div></div>
                  <span style="font-size:12px;color:var(--text-muted);white-space:nowrap;">${pct}%</span>
                </div>
              </td>
              <td>${formatNumber(c.total_contacts)}</td>
              <td>${formatNumber(c.sent_count)}</td>
              <td><span style="color:var(--success);font-weight:500;">${formatNumber(c.delivered_count)}</span></td>
              <td><span style="color:var(--info);font-weight:500;">${formatNumber(c.read_count)}</span></td>
              <td><span style="color:var(--danger);font-weight:500;">${formatNumber(c.failed_count + c.undelivered_count)}</span></td>
              <td>${formatDate(c.created_at)}</td>
              <td><div class="row-actions" style="display:flex;gap:6px;">
                <a class="btn btn-sm btn-secondary" href="/campaigns/${c.id}">View</a>
                ${c.status !== 'sending' ? `<button class="btn btn-sm btn-danger btn-delete-campaign" data-id="${c.id}">🗑</button>` : ''}
              </div></td>
            </tr>`;
          }).join('');
        }
        pagination.classList.add('pagination');
        paginateUi({ container: pagination, total: data.total, page, perPage, onChange: (p: number) => { page = p; loadCampaigns(); } });
      } catch(_) {}
    }

    document.addEventListener('click', async (event) => {
      const deleteBtn = (event.target as HTMLElement)?.closest('.btn-delete-campaign');
      if (!deleteBtn) return;
      event.preventDefault();
      event.stopPropagation();
      const id = (deleteBtn as HTMLElement).dataset.id;
      if (!id || !confirm('Delete this campaign?')) return;
      try {
        await api(`/api/campaigns/${id}`, { method: 'DELETE' });
        toast('Campaign deleted', 'success');
        await loadCampaigns();
      } catch (_) {}
    });

    searchInput.addEventListener('input', loadCampaigns);
    statusFilter.addEventListener('change', () => { page = 1; loadCampaigns(); });
    loadCampaigns();
    setInterval(loadCampaigns, 10000);
  </script>
</Layout>
