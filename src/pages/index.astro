---
import Layout from '../layouts/Layout.astro';
import { getDashboardStats } from '../services/campaigns';
import { statusMeta, formatNumber, formatDate } from '../scripts/app.js';

const initialStats = await getDashboardStats();
const initialCampaigns = initialStats.campaigns || [];
---

<Layout>
  <Fragment slot="title">Dashboard</Fragment>

  <div class="stat-grid" style="margin-bottom:28px;" id="statsGrid">
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--accent-light);color:var(--accent);">📊</div>
      <div class="stat-label">Total Campaigns</div>
      <div class="stat-value" data-stat="totalCampaigns">{formatNumber(initialStats.totalCampaigns)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--success-light);color:var(--success);">👥</div>
      <div class="stat-label">Active Contacts</div>
      <div class="stat-value" data-stat="totalContacts">{formatNumber(initialStats.totalContacts)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--info-light);color:var(--info);">📤</div>
      <div class="stat-label">Active Campaigns</div>
      <div class="stat-value" data-stat="activeCampaigns">{formatNumber(initialStats.activeCampaigns)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--warning-light);color:var(--warning);">📨</div>
      <div class="stat-label">Messages Sent</div>
      <div class="stat-value" data-stat="totalSent">{formatNumber(initialStats.totalSent)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--success-light);color:var(--success);">✓</div>
      <div class="stat-label">Delivered</div>
      <div class="stat-value" data-stat="totalDelivered">{formatNumber(initialStats.totalDelivered)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--info-light);color:var(--info);">👁</div>
      <div class="stat-label">Read</div>
      <div class="stat-value" data-stat="totalRead">{formatNumber(initialStats.totalRead)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">✕</div>
      <div class="stat-label">Failed</div>
      <div class="stat-value" data-stat="totalFailed">{formatNumber(initialStats.totalFailed)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:var(--danger-light);color:var(--danger);">🚫</div>
      <div class="stat-label">Opt-outs</div>
      <div class="stat-value" data-stat="optOuts">{formatNumber(initialStats.optOuts)}</div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px;" class="stat-grid">
    <div class="card">
      <div class="card-header">
        <div class="card-title">Recent Campaigns</div>
        <a href="/campaigns/new" class="btn btn-primary btn-sm">+ Compose Message</a>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr><th>Name</th><th>Status</th><th>Sent</th><th>Delivered</th><th>Read</th><th>Failed</th><th>Created</th></tr>
          </thead>
          <tbody id="campaignsTbody">
            {initialCampaigns.length === 0 ? (
              <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">No campaigns yet. <a href="/campaigns/new">Compose one</a></td></tr>
            ) : (
              initialCampaigns.map((c: any) => {
                const meta = statusMeta(c.status);
                return (
                  <tr>
                    <td>
                      <a href={`/campaigns/${c.id}`} style="font-weight:500">{c.name}</a>
                      {c.list_name && <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">{c.list_name}</div>}
                    </td>
                    <td><span class={`badge ${meta.cls}`}>{meta.label}</span></td>
                    <td>{formatNumber(c.sent_count)}</td>
                    <td>{formatNumber(c.delivered_count)}</td>
                    <td>{formatNumber(c.read_count)}</td>
                    <td>{formatNumber(c.failed_count + c.undelivered_count)}</td>
                    <td>{formatDate(c.created_at)}</td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div class="card-title">Quick Actions</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <a href="/campaigns/new" class="btn btn-primary" style="justify-content:flex-start">✉️ Compose Message</a>
        <a href="/campaigns" class="btn btn-secondary" style="justify-content:flex-start">📤 View Campaigns</a>
        <a href="/import" class="btn btn-secondary" style="justify-content:flex-start">📥 Import Contacts</a>
        <a href="/contacts" class="btn btn-secondary" style="justify-content:flex-start">👥 Manage Contacts</a>
        <a href="/settings" class="btn btn-secondary" style="justify-content:flex-start">⚙️ Twilio Settings</a>
      </div>
    </div>
  </div>

  <script>
    import { api, formatDate, statusMeta, escapeHtml, formatNumber, setupModals } from '../scripts/app.js';

    setupModals();

    async function loadDashboard() {
      try {
        const s = await api('/api/dashboard/stats');
        document.querySelectorAll<HTMLElement>('[data-stat]').forEach(el => {
          const key = el.getAttribute('data-stat')!;
          const map: Record<string, any> = {
            totalCampaigns: s.totalCampaigns,
            totalContacts: s.totalContacts,
            activeCampaigns: s.activeCampaigns,
            totalSent: s.totalSent,
            totalDelivered: s.totalDelivered,
            totalRead: s.totalRead,
            totalFailed: s.totalFailed,
            optOuts: s.optOuts,
          };
          if (map[key] !== undefined) el.textContent = formatNumber(map[key]);
        });

        const campaignsTbody = document.getElementById('campaignsTbody')!;
        if (!s.campaigns?.length) {
          campaignsTbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">No campaigns yet. <a href="/campaigns/new">Compose one</a></td></tr>`;
        } else {
          campaignsTbody.innerHTML = s.campaigns.map((c: any) => {
            const meta = statusMeta(c.status);
            return `<tr>
              <td><a href="/campaigns/${c.id}" style="font-weight:500">${escapeHtml(c.name)}</a>${c.list_name ? `<div style="font-size:11px;color:var(--text-muted);margin-top:2px;">${escapeHtml(c.list_name)}</div>` : ''}</td>
              <td><span class="badge ${meta.cls}">${meta.label}</span></td>
              <td>${formatNumber(c.sent_count)}</td>
              <td>${formatNumber(c.delivered_count)}</td>
              <td>${formatNumber(c.read_count)}</td>
              <td>${formatNumber(c.failed_count + c.undelivered_count)}</td>
              <td>${formatDate(c.created_at)}</td>
            </tr>`;
          }).join('');
        }
      } catch (e) { console.error(e); }
    }

    loadDashboard();
    setInterval(loadDashboard, 15000);
  </script>
</Layout>
