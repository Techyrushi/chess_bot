---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Fragment slot="title">Audit Logs</Fragment>

  <div class="breadcrumbs"><a href="/">Dashboard</a> / <span>Audit Logs</span></div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Activity & Audit Trail</div>
    </div>
    <div class="filters-row">
      <div style="flex:1;min-width:240px;">
        <select id="actionFilter">
          <option value="">All actions</option>
          <option value="login">login</option>
          <option value="logout">logout</option>
          <option value="contact_created">contact_created</option>
          <option value="contact_updated">contact_updated</option>
          <option value="contact_deleted">contact_deleted</option>
          <option value="contacts_imported">contacts_imported</option>
          <option value="campaign_created">campaign_created</option>
          <option value="campaign_updated">campaign_updated</option>
          <option value="campaign_start">campaign_start</option>
          <option value="campaign_pause">campaign_pause</option>
          <option value="campaign_resume">campaign_resume</option>
          <option value="campaign_cancel">campaign_cancel</option>
          <option value="optout_created">optout_created</option>
          <option value="settings_updated">settings_updated</option>
          <option value="reply_sent">reply_sent</option>
          <option value="test_message_sent">test_message_sent</option>
        </select>
      </div>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Time</th><th>Admin</th><th>Action</th><th>Resource</th><th>Details</th><th>IP</th></tr></thead>
        <tbody id="tbody"><tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted);">Loading...</td></tr></tbody>
      </table>
    </div>
    <div class="pagination" id="pagination"></div>
  </div>

  <script>
    import { api, formatDate, escapeHtml, paginateUi } from '../scripts/app.js';
    const tbody = document.getElementById('tbody')!;
    const pagination = document.getElementById('pagination')!;
    const actionFilter = document.getElementById('actionFilter') as HTMLSelectElement;
    let offset = 0; const limit = 50;
    async function load() {
      try {
        const p = new URLSearchParams({ limit: String(limit), offset: String(offset) });
        if (actionFilter.value) p.append('action', actionFilter.value);
        const data = await api('/api/audit-logs?' + p.toString());
        if (!data.logs.length) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:60px;color:var(--text-muted);">No logs</td></tr>`;
        } else {
          tbody.innerHTML = data.logs.map((l: any) => `<tr>
            <td style="white-space:nowrap;">${formatDate(l.created_at)}</td>
            <td>${l.admin_email ? escapeHtml(l.admin_email) : '<span style="color:var(--text-muted);">system</span>'}</td>
            <td><span class="chip">${escapeHtml(l.action)}</span></td>
            <td>${l.resource_type ? `${escapeHtml(l.resource_type)} #${l.resource_id}` : '-'}</td>
            <td style="max-width:420px;">${l.details ? `<details><summary style="cursor:pointer;">${escapeHtml(JSON.stringify(JSON.parse(l.details)).slice(0,80))}${JSON.stringify(JSON.parse(l.details)).length>80?'…':''}</summary><div class="audit-details">${escapeHtml(JSON.stringify(JSON.parse(l.details), null, 2))}</div></details>` : '-'}</td>
            <td style="font-family:monospace;font-size:12px;color:var(--text-muted);">${escapeHtml(l.ip_address || '-')}</td>
          </tr>`).join('');
        }
        pagination.classList.add('pagination');
        const page = Math.floor(offset / limit) + 1;
        paginateUi({ container: pagination, total: data.total, page, perPage: limit, onChange: (p: number) => { offset = (p - 1) * limit; load(); } });
      } catch(_) {}
    }
    actionFilter.addEventListener('change', () => { offset = 0; load(); });
    load();
  </script>
</Layout>
