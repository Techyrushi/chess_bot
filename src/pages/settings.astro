---
import Layout from '../layouts/Layout.astro';
import { getAdminById } from '../lib/auth';

const cookieHeader = Astro.request.headers.get('cookie');
const sessionId = (await import('../lib/sessions')).parseSessionFromCookies(cookieHeader);
const session = sessionId ? await (await import('../lib/sessions')).getSession(sessionId) : null;
const admin = session?.adminId ? await getAdminById(session.adminId) : null;
---

<Layout>
  <Fragment slot="title">Settings</Fragment>

  <div class="breadcrumbs"><a href="/">Dashboard</a> / <span>Settings</span></div>

  <div class="tabs">
    <button class="tab active" data-tab="twilio">Twilio</button>
    <button class="tab" data-tab="sending">Sending</button>
    <button class="tab" data-tab="test">Test Message</button>
    <button class="tab" data-tab="security">Security</button>
    <button class="tab" data-tab="webhooks">Webhooks</button>
  </div>

  <div id="tab-twilio" class="card tab-panel">
    <div class="card-header"><div class="card-title">Twilio API Configuration</div></div>
    <form id="twilioForm">
      <div class="form-grid">
        <div class="form-group">
          <label>Account SID</label>
          <input name="twilio_account_sid" placeholder="AC..." value="" />
          <div class="form-hint">Found in Twilio Console → Account Info</div>
        </div>
        <div class="form-group">
          <label>Auth Token</label>
          <input name="twilio_auth_token" type="password" placeholder="••••••••" value="" />
          <div class="form-hint">Keep this secret. Never expose to the client.</div>
        </div>
        <div class="form-group">
          <label>WhatsApp Sender Number</label>
          <input name="twilio_whatsapp_number" placeholder="whatsapp:+14155238886" value="" />
          <div class="form-hint">Format: <code>whatsapp:+1234567890</code></div>
        </div>
        <div class="form-group">
          <label>Webhook Secret (signature verification)</label>
          <input name="twilio_webhook_secret" type="password" placeholder="Change me" value="" />
        </div>
      </div>
      <div style="margin-top:16px;padding:14px;background:var(--info-light);border-radius:var(--radius);font-size:13px;color:var(--info);">
        <strong>Webhook URLs (configure in Twilio Console → WhatsApp → Senders):</strong>
        <div style="margin-top:6px;">
          Status Callback: <code style="user-select:all;">{Astro.url.origin}/api/webhooks/twilio/status</code>
        </div>
        <div style="margin-top:4px;">
          Incoming Messages: <code style="user-select:all;">{Astro.url.origin}/api/webhooks/twilio/incoming</code>
        </div>
      </div>
      <div style="margin-top:20px;"><button class="btn btn-primary" type="submit">💾 Save Twilio Settings</button></div>
    </form>
  </div>

  <div id="tab-sending" class="card tab-panel" style="display:none;">
    <div class="card-header"><div class="card-title">Sending Defaults</div></div>
    <form id="sendingForm">
      <div class="form-grid">
        <div class="form-group">
          <label>Minimum send delay (ms)</label>
          <input type="number" name="send_delay_min_ms" min="100" step="100" />
          <div class="form-hint">Default 1000ms (1s). Prevents rate limits.</div>
        </div>
        <div class="form-group">
          <label>Maximum send delay (ms)</label>
          <input type="number" name="send_delay_max_ms" min="200" step="100" />
          <div class="form-hint">Default 3000ms (3s). Randomized per message.</div>
        </div>
        <div class="form-group">
          <label>Max retries per message</label>
          <input type="number" name="max_retries" min="0" max="10" />
          <div class="form-hint">Retries only on transient failures.</div>
        </div>
      </div>
      <div style="margin-top:20px;"><button class="btn btn-primary" type="submit">💾 Save Sending Settings</button></div>
    </form>
  </div>

  <div id="tab-test" class="card tab-panel" style="display:none;">
    <div class="card-header"><div class="card-title">Send a Test Message</div></div>
    <form id="testForm">
      <div class="form-grid">
        <div class="form-group"><label>To (Phone Number) *</label><input name="phone" required placeholder="+918446225859 or +1234567890" /></div>
        <div class="form-group"><label>Media URL (optional)</label><input type="url" name="mediaUrl" placeholder="https://example.com/image.jpg" /></div>
      </div>
      <div class="form-group">
        <label>Message Body *</label>
        <textarea name="body" rows="5" required placeholder="Hello world! This is a test message from your WhatsApp Campaign Manager."></textarea>
      </div>
      <div style="margin-top:8px;"><button class="btn btn-success" type="submit" id="testSendBtn">📤 Send Test Message</button></div>
    </form>
    <div id="testResultBox" style="display:none;margin-top:16px;padding:14px;border-radius:var(--radius);font-size:13px;"></div>
  </div>

  <div id="tab-security" class="card tab-panel" style="display:none;">
    <div class="card-header"><div class="card-title">Admin Account & Security</div></div>
    <div style="padding:14px;background:var(--bg-tertiary);border-radius:var(--radius);margin-bottom:20px;display:flex;align-items:center;gap:14px;">
      <div style="width:48px;height:48px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;">
        {((admin?.name || admin?.email || 'A').charAt(0)).toUpperCase()}
      </div>
      <div>
        <div style="font-weight:600;font-size:15px;">{admin?.name || 'Administrator'}</div>
        <div style="color:var(--text-muted);font-size:13px;">{admin?.email}</div>
      </div>
    </div>
    <form id="passwordForm">
      <div class="form-group">
        <label>Current Password *</label>
        <input name="email" type="hidden" value={admin?.email} />
        <input type="password" name="currentPassword" required />
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>New Password *</label>
          <input type="password" name="newPassword" minlength="8" required />
          <div class="form-hint">Minimum 8 characters</div>
        </div>
      </div>
      <div style="margin-top:10px;"><button class="btn btn-primary" type="submit">🔒 Update Password</button></div>
    </form>
  </div>

  <div id="tab-webhooks" class="card tab-panel" style="display:none;">
    <div class="card-header"><div class="card-title">Webhook Reference</div></div>
    <div style="font-size:14px;line-height:1.7;">
      <p style="margin-bottom:14px;">All webhook endpoints use Twilio signature verification with X-Twilio-Signature header and idempotency keys.</p>

      <div style="padding:14px;background:var(--bg-tertiary);border-radius:var(--radius);margin-bottom:14px;">
        <h3 style="font-size:14px;margin-bottom:8px;font-weight:600;">Status Webhook</h3>
        <p style="font-family:monospace;font-size:12px;padding:8px;background:var(--bg-primary);border-radius:4px;">POST {Astro.url.origin}/api/webhooks/twilio/status</p>
        <p style="margin-top:8px;font-size:13px;color:var(--text-secondary);">Receives Twilio status callbacks. Updates message rows and campaign aggregates. Idempotent per (MessageSid, MessageStatus).</p>
      </div>

      <div style="padding:14px;background:var(--bg-tertiary);border-radius:var(--radius);">
        <h3 style="font-size:14px;margin-bottom:8px;font-weight:600;">Incoming Messages Webhook</h3>
        <p style="font-family:monospace;font-size:12px;padding:8px;background:var(--bg-primary);border-radius:4px;">POST {Astro.url.origin}/api/webhooks/twilio/incoming</p>
        <p style="margin-top:8px;font-size:13px;color:var(--text-secondary);">Receives inbound WhatsApp messages. Auto-opts-out users replying STOP/CANCEL/UNSUBSCRIBE/QUIT/END.</p>
      </div>
    </div>
  </div>

  <script>
    import { api, toast, setupModals } from '../scripts/app.js';
    setupModals();

    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-tab');
        if (!id) return;
        document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t === tab));
        document.querySelectorAll('.tab-panel').forEach(p => {
          const panel = p as HTMLElement;
          panel.style.display = panel.id === `tab-${id}` ? '' : 'none';
        });
      });
    });

    async function loadSettings() {
      try {
        const s = await api('/api/settings');
        const acctSid = document.querySelector<HTMLInputElement>('[name="twilio_account_sid"]');
        const authTok = document.querySelector<HTMLInputElement>('[name="twilio_auth_token"]');
        const waNum = document.querySelector<HTMLInputElement>('[name="twilio_whatsapp_number"]');
        const whSecret = document.querySelector<HTMLInputElement>('[name="twilio_webhook_secret"]');
        const delayMin = document.querySelector<HTMLInputElement>('[name="send_delay_min_ms"]');
        const delayMax = document.querySelector<HTMLInputElement>('[name="send_delay_max_ms"]');
        const maxRet = document.querySelector<HTMLInputElement>('[name="max_retries"]');
        if (acctSid) acctSid.value = s.twilio_account_sid || '';
        if (authTok) authTok.value = s.twilio_auth_token || '';
        if (waNum) waNum.value = s.twilio_whatsapp_number || '';
        if (whSecret) whSecret.value = s.twilio_webhook_secret || '';
        if (delayMin) delayMin.value = s.send_delay_min_ms || '1000';
        if (delayMax) delayMax.value = s.send_delay_max_ms || '3000';
        if (maxRet) maxRet.value = s.max_retries || '3';
      } catch(_) {}
    }
    loadSettings();

    async function submitGeneric(formEl: HTMLFormElement, extra = {}) {
      const data = Object.fromEntries(new FormData(formEl).entries());
      Object.assign(data, extra);
      const r = await api('/api/settings', { method: 'POST', body: data });
      return r;
    }

    const twilioForm = document.getElementById('twilioForm') as HTMLFormElement | null;
    const sendingForm = document.getElementById('sendingForm') as HTMLFormElement | null;
    const testForm = document.getElementById('testForm') as HTMLFormElement | null;
    const passwordForm = document.getElementById('passwordForm') as HTMLFormElement | null;

    twilioForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      try { await submitGeneric(e.target as HTMLFormElement); toast('Twilio settings saved', 'success'); loadSettings(); } catch(_) {}
    });
    sendingForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      try { await submitGeneric(e.target as HTMLFormElement); toast('Sending settings saved', 'success'); loadSettings(); } catch(_) {}
    });
    const testSendBtn = document.getElementById('testSendBtn') as HTMLButtonElement | null;
    const testResultBox = document.getElementById('testResultBox');

    testForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      if (testSendBtn) {
        testSendBtn.disabled = true;
        testSendBtn.textContent = '⏳ Sending test message...';
      }
      if (testResultBox) testResultBox.style.display = 'none';

      try {
        const phoneEl = f.querySelector<HTMLInputElement>('[name="phone"]');
        const bodyEl = f.querySelector<HTMLTextAreaElement>('[name="body"]');
        const mediaEl = f.querySelector<HTMLInputElement>('[name="mediaUrl"]');
        const r = await api('/api/test-message', {
          method: 'POST',
          body: {
            phone: phoneEl ? phoneEl.value : '',
            body: bodyEl ? bodyEl.value : '',
            mediaUrl: mediaEl && mediaEl.value ? mediaEl.value : undefined
          }
        });

        if (testResultBox) {
          testResultBox.style.display = 'block';
          if (r.success) {
            testResultBox.style.background = 'var(--success-light)';
            testResultBox.style.color = 'var(--success)';
            testResultBox.style.border = '1px solid var(--success)';
            testResultBox.innerHTML = `<strong>✅ Test Message Dispatched!</strong><br />
              <span style="font-family:monospace;font-size:12px;margin-top:4px;display:inline-block;">Twilio Message SID: ${r.sid}</span><br />
              <span>Status: <strong>${r.status || 'queued'}</strong></span>`;
            toast(`Dispatched! SID: ${r.sid}`, 'success', 'Message Queued');
          } else {
            testResultBox.style.background = 'var(--danger-light)';
            testResultBox.style.color = 'var(--danger)';
            testResultBox.style.border = '1px solid var(--danger)';
            testResultBox.innerHTML = `<strong>❌ Failed to send:</strong> ${r.errorMessage || 'Error'}<br />
              ${r.errorCode ? `<span style="font-size:12px;">Twilio Error Code: ${r.errorCode}</span><br />` : ''}
              <span style="font-size:12px;opacity:0.9;">Tip: If using sandbox, recipient must send sandbox join keyword. If using a business number outside 24h session, use approved WhatsApp templates.</span>`;
            toast(r.errorMessage || 'Failed to send message', 'error', 'Error');
          }
        }
      } catch (err: any) {
        if (testResultBox) {
          testResultBox.style.display = 'block';
          testResultBox.style.background = 'var(--danger-light)';
          testResultBox.style.color = 'var(--danger)';
          testResultBox.style.border = '1px solid var(--danger)';
          testResultBox.innerHTML = `<strong>❌ Error:</strong> ${err.message || 'Failed to dispatch test message'}`;
        }
      } finally {
        if (testSendBtn) {
          testSendBtn.disabled = false;
          testSendBtn.textContent = '📤 Send Test Message';
        }
      }
    });
    passwordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        await submitGeneric(e.target as HTMLFormElement, { changePassword: true });
        toast('Password updated', 'success');
        if (e.target && typeof (e.target as HTMLFormElement).reset === 'function') (e.target as HTMLFormElement).reset();
      } catch(_) {}
    });
  </script>
</Layout>
