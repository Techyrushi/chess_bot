NODE_ENV=development
PORT=4321

SESSION_SECRET=replace-with-a-long-random-value
SESSION_MAX_AGE=86400000

DB_URI=mongodb://localhost:27017
DB_NAME=whatsapp-campaign

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000
TWILIO_WEBHOOK_SECRET=replace-with-webhook-secret
DEFAULT_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_URL=http://localhost:4321

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=25000000
SEND_DELAY_MIN_MS=1000
SEND_DELAY_MAX_MS=3000
MAX_RETRIES=3
DRY_RUN=true
